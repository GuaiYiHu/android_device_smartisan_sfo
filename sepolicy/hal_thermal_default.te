# Read the discovered thermal zones, battery health, and actual cooling caps.
allow hal_thermal_default sysfs:dir r_dir_perms;
allow hal_thermal_default sysfs:lnk_file read;
allow hal_thermal_default sysfs_type:dir search;
r_dir_file(hal_thermal_default, sysfs_thermal)
allow hal_thermal_default sysfs_battery_supply:file r_file_perms;
allow hal_thermal_default sysfs_kgsl:file r_file_perms;
allow hal_thermal_default sysfs_mpdecision:file r_file_perms;
allow hal_thermal_default sysfs_devices_system_cpu:file r_file_perms;
