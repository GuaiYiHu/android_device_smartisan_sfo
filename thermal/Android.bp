// SPDX-License-Identifier: Apache-2.0
cc_binary {
    name: "android.hardware.thermal-service.sfo",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.thermal-service.sfo.rc"],
    vintf_fragments: ["android.hardware.thermal-service.sfo.xml"],
    srcs: ["service.cpp", "Thermal.cpp", "Sensors.cpp"],
    static_libs: ["android.hardware.thermal-V1-ndk", "libbase"],
    shared_libs: ["libbinder_ndk", "liblog"],
    stl: "c++_static",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_test {
    name: "sfo_thermal_hal_test",
    vendor: true,
    srcs: ["tests/ThermalTest.cpp", "Thermal.cpp", "Sensors.cpp"],
    local_include_dirs: ["."],
    static_libs: ["android.hardware.thermal-V1-ndk"],
    shared_libs: ["libbinder_ndk", "liblog"],
    stl: "c++_static",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    test_suites: ["device-tests"],
}
