cc_binary {
    name: "android.hardware.light@2.0-service.sfo",
    relative_install_path: "hw",
    defaults: ["hidl_defaults"],
    proprietary: true,
    init_rc: ["android.hardware.light@2.0-service.sfo.rc"],
    srcs: [
        "Light.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.light@2.0",
        "libbase",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}
